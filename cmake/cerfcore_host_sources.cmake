function(cerfcore_select_host_sources list_var)
    set(sources ${${list_var}})
    if(WIN32)
        list(FILTER sources EXCLUDE REGEX "_posix\\.cpp$")
    else()
        list(FILTER sources EXCLUDE REGEX "_(win32|windows)\\.cpp$")
    endif()
    if(NOT CMAKE_SYSTEM_NAME MATCHES "^(Linux|Android)$")
        list(FILTER sources EXCLUDE REGEX "_linux\\.cpp$")
    endif()
    if(NOT APPLE)
        list(FILTER sources EXCLUDE REGEX "_macos\\.(cpp|mm)$")
    endif()
    if(ANDROID)
        set(android_sources ${sources})
        list(FILTER android_sources INCLUDE REGEX "_android\\.cpp$")
        foreach(android_source IN LISTS android_sources)
            string(REGEX REPLACE "_android\\.cpp$" "" stem "${android_source}")
            list(REMOVE_ITEM sources "${stem}_linux.cpp" "${stem}_posix.cpp")
        endforeach()
    else()
        list(FILTER sources EXCLUDE REGEX "_android\\.cpp$")
    endif()
    set(default_sources ${sources})
    list(FILTER default_sources INCLUDE REGEX "_default\\.cpp$")
    foreach(default_source IN LISTS default_sources)
        string(REGEX REPLACE "_default\\.cpp$" "" stem "${default_source}")
        foreach(sibling IN ITEMS _windows.cpp _win32.cpp _linux.cpp _posix.cpp _macos.cpp _macos.mm _android.cpp)
            if("${stem}${sibling}" IN_LIST sources)
                list(REMOVE_ITEM sources "${default_source}")
                break()
            endif()
        endforeach()
    endforeach()
    set(${list_var} ${sources} PARENT_SCOPE)
endfunction()
